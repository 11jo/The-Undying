	Global("BeholderBehavior","LOCALS",1)
	See([PC])
	HPGT(Myself,35)
	!HasBounceEffects(SecondNearest([PC]))
THEN
	RESPONSE #100
		FaceObject(SecondNearest([PC]))
		ForceSpell(SecondNearest([PC]),BEHOLDER_SLOW)  // SPIN983.SPL (Lenteur)
		Wait(2)
		Continue()
END

IF
	Global("BeholderBehavior","LOCALS",1)
	See([PC])
	HPGT(Myself,5)
	!HasBounceEffects(ThirdNearest([PC]))
THEN
	RESPONSE #100
		FaceObject(ThirdNearest([PC]))
		ForceSpell(ThirdNearest([PC]),BEHOLDER_CAUSE_SERIOUS_WOUNDS)  // SPIN986.SPL (Blessures graves)
		Continue()
END

IF
	Global("BeholderBehavior","LOCALS",1)
	See(LeastDamagedOf(Myself))
	!HasBounceEffects(LeastDamagedOf(Myself))
THEN
	RESPONSE #100
		FaceObject(LeastDamagedOf(Myself))
		ForceSpell(LeastDamagedOf(Myself),BEHOLDER_DEATH_RAY)  // SPIN991.SPL (Rayon de mort)
		Continue()
END

IF
	Global("BeholderBehavior","LOCALS",1)
	See([PC])
	!See(LeastDamagedOf(Myself))
	!HasBounceEffects([PC])
THEN
	RESPONSE #100
		FaceObject([PC])
		ForceSpell([PC],BEHOLDER_DEATH_RAY)  // SPIN991.SPL (Rayon de mort)
		Continue()
END

IF
	See(NearestEnemyOf(Myself))
	HaveSpell(WIZARD_IMPRISONMENT)  // SPWI910.SPL (Emprisonnement)
THEN
	RESPONSE #100
		Spell(NearestEnemyOf(Myself),WIZARD_IMPRISONMENT)  // SPWI910.SPL (Emprisonnement)
END

IF
	Global("BeholderBehavior","LOCALS",1)
	See([PC.0.0.MAGE])
	!StateCheck(LastSeenBy(Myself),STATE_STUNNED)
	!HasBounceEffects([PC.0.0.MAGE])
THEN
	RESPONSE #100
		FaceObject(LastSeenBy(Myself))
		ForceSpell(LastSeenBy(Myself),BEHOLDER_ANTIMAGIC_RAY)  // SPIN992.SPL (Rayon antimagie)
		AttackReevaluate(LastSeenBy(Myself),15)
		SetGlobal("BeholderBehavior","LOCALS",0)
END

IF
	See(NearestEnemyOf(Myself))
	HaveSpell(WIZARD_MAZE)  // SPWI813.SPL (Labyrinthe)
THEN
	RESPONSE #100
		Spell(NearestEnemyOf(Myself),WIZARD_MAZE)  // SPWI813.SPL (Labyrinthe)
END

IF
	See(NearestEnemyOf(Myself))
	HaveSpell(WIZARD_POWER_WORD_KILL)  // SPWI912.SPL (Mot de pouvoir : mort)
	HPLT(LastSeenBy(Myself),60)
THEN
	RESPONSE #100
		Spell(NearestEnemyOf(Myself),WIZARD_POWER_WORD_KILL)  // SPWI912.SPL (Mot de pouvoir : mort)
END

IF
	See([PC])
	HasBounceEffects([PC])
	Global("KRBEHELD","LOCALS",0)
THEN
	RESPONSE #100
		IncrementGlobal("KRBEHELD","LOCALS",1)
		ForceSpell(Myself,WIZARD_INVISIBLE_STALKER)  // SPWI601.SPL (Rôdeur invisible)
		SetGlobalTimer("KRTIMER","GLOBAL",TEN_ROUNDS)
END

IF
	GlobalTimerExpired("KRTIMER","GLOBAL")
THEN
	RESPONSE #100
		SetGlobal("KRBEHELD","LOCALS",0)
END

