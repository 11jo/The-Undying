	Global("BeholderBehavior","LOCALS",0)
	See([PC])
	!See(LeastDamagedOf(Myself))
	HPGT(Myself,45)
	!HasBounceEffects([PC])
THEN
	RESPONSE #100
		FaceObject([PC])
		ForceSpell([PC],BEHOLDER_CAUSE_SERIOUS_WOUNDS)  // SPIN986.SPL (Blessures graves)
		Continue()
END

IF
	Global("BeholderBehavior","LOCALS",0)
	See([PC])
	HPGT(Myself,25)
	!HasBounceEffects(ThirdNearest([PC]))
THEN
	RESPONSE #100
		FaceObject(ThirdNearest([PC]))
		ForceSpell(ThirdNearest([PC]),BEHOLDER_FLESH_TO_STONE)  // SPIN984.SPL (Transmutation de la chair en pierre)
		Continue()
END

IF
	Global("BeholderBehavior","LOCALS",0)
	See([PC])
	See([PC.0.0.MAGE])
	!HasBounceEffects([PC.0.0.MAGE])
THEN
	RESPONSE #100
		FaceObject(LastSeenBy(Myself))
		ForceSpell(LastSeenBy(Myself),BEHOLDER_ANTIMAGIC_RAY)  // SPIN992.SPL (Rayon antimagie)
		SetGlobal("BeholderBehavior","LOCALS",1)
		Wait(2)
END

IF
	See(NearestEnemyOf(Myself))
	Global("SpellTrigger","LOCALS",0)
THEN
	RESPONSE #100
		DisplayString(Myself,39968)  // Déclencheur de sorts lancé
		DisplayString(Myself,40248)  // Déclencheur de sorts : Vision véritable
		ReallyForceSpell(NearestEnemyOf(Myself),WIZARD_TRUE_SIGHT)  // SPWI609.SPL (Vision véritable)
		DisplayString(Myself,40249)  // Déclencheur de sorts : Dissipation de la magie
		ReallyForceSpell(NearestEnemyOf(Myself),WIZARD_REMOVE_MAGIC)  // SPWI302.SPL (Délivrance de la magie)
		DisplayString(Myself,40250)  // Déclencheur de sorts : Boule de feu
		ReallyForceSpell(NearestEnemyOf(Myself),WIZARD_FIREBALL)  // SPWI304.SPL (Boule de feu)
		SetGlobal("SpellTrigger","LOCALS",1)
END

IF
	Global("BeholderBehavior","LOCALS",0)
	!See([PC.0.0.MAGE])
	!HasBounceEffects([PC.0.0.MAGE])
THEN
	RESPONSE #100
		FaceObject(LastSeenBy(Myself))
		ForceSpell(LastSeenBy(Myself),BEHOLDER_ANTIMAGIC_RAY)  // SPIN992.SPL (Rayon antimagie)
		SetGlobal("BeholderBehavior","LOCALS",1)
END

IF
	Global("BeholderBehavior","LOCALS",1)
	See([GOODCUTOFF.0.0.0.0.SUMMONED])
	Global("summon2","LOCALS",0)
	!HasBounceEffects([GOODCUTOFF.0.0.0.0.SUMMONED])
THEN
	RESPONSE #100
		FaceObject(LastSeenBy(Myself))
		ForceSpell(LastSeenBy(Myself),BEHOLDER_PARALYZATION)  // SPIN990.SPL (Paralysie)
		ForceSpell(LastSeenBy(Myself),WIZARD_MELF_ACID_ARROW)  // SPWI211.SPL (Flèche acide de Melf)
		SetGlobal("summon2","LOCALS",1)
END

IF
	Global("BeholderBehavior","LOCALS",1)
	See([PC])
	HPGT(Myself,15)
	!HasBounceEffects([PC])
THEN
	RESPONSE #100
		FaceObject([PC])
		ForceSpell([PC],BEHOLDER_DOMINATION)  // SPIN985.SPL (Domination)
		Continue()
END

