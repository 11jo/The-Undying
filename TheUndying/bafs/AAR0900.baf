IF
   Global("CmTUStore3Exists","MYAREA",0)
THEN
   RESPONSE #100
      SetGlobal("CmTUStore3Exists","MYAREA",1)
      CreateCreature("CMTUS03",[2717.2024],2)
END

IF
	Global("CmMystraPriest","MYAREA",0)
	Global("NinaJoin","GLOBAL",1)
THEN
	RESPONSE #100
		CreateCreature("CMNINAMY",[3725.1610],0) // Priest of Mystra
		SetGlobal("CmMystraPriest","MYAREA",1)
END

IF
	Global("DoSSpawn","MYAREA",0)
THEN
	RESPONSE #100
		CreateCreature("CMDRWP",[3984.3782],1) // Drow Priestess
		SetGlobal("DoSSpawn","MYAREA",1)
END

