IF
  EXISTS("CMGHOST1")
  TimeGT(DUSK_START)
  Global("DoSGhost1Bed","AR0800",1)
THEN
  RESPONSE #100
    Activate("CMGHOST1")
    SetGlobal("DoSGhost1Bed","AR0800",0)
END

