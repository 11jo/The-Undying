IF
	Global("DoSSpawn","AR0800",0)
THEN
	RESPONSE #100
		CreateCreature("CMGHOST1",[1334.1314],0) // 
		CreateCreature("CMGHOST2",[1087.1971],0) // 
		CreateCreature("CMGHOST3",[1190.541],0) // 
		SetGlobal("DoSSpawn","AR0800",1)
END

IF
  EXISTS("CMGHOST1")
  TimeGT(DAWN_START)
  Global("DoSGhost1Bed","AR0800",0)
THEN
  RESPONSE #100
    Deactivate("CMGHOST1")
    SetGlobal("DoSGhost1Bed","AR0800",1)
END

IF
  EXISTS("CMGHOST2")
  TimeGT(DAWN_START)
  Global("DoSGhost2Bed","AR0800",0)
THEN
  RESPONSE #100
    Deactivate("CMGHOST2")
    SetGlobal("DoSGhost2Bed","AR0800",1)
END

