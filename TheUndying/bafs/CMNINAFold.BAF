InParty(Myself)
InParty("Anomen")
RealGlobalTimerExpired("NinaAnomenKnightTalk2Check","GLOBAL")
See("Anomen")
!StateCheck("Anomen",CD_STATE_NOTVALID)
!StateCheck(Myself,CD_STATE_NOTVALID)
CombatCounter(0)
!See([ENEMY])
THEN
RESPONSE #100
SetGlobal("NinaAnomenKnightTalk2","GLOBAL",2)
END

IF
Global("NinaAnomenKnightTalk2","GLOBAL",2)
InParty(Myself)
InParty("Anomen")
See("Anomen")
!StateCheck("Anomen",CD_STATE_NOTVALID)
!StateCheck(Myself,CD_STATE_NOTVALID)
THEN
RESPONSE #100
Interact("Anomen")
END

