IF
	See(Player1)
	Global("CmNinaJoined","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("CmNinaJoined","LOCALS",1)
		Dialogue(Player1)
END

IF
	Global("FoundThievesC","GLOBAL",1)
	Global("MystraQuest","GLOBAL",0)
	Dead("cmlillian")
	PartyHasItem("CMBOOK99") // Tome of Magical Spells
THEN
	RESPONSE #100
		Interact(Player1)
END

// Tanner warning

IF
	InParty(Myself)
	Global("TannerWarning2","AR0502",0)
THEN
	RESPONSE #100
		SetGlobal("TannerWarning2","AR0502",1)
		StartDialogueNoSet(Player1)
END

// Anomen, Ninafer and PC triangle check In other words its me or else

IF
InParty(Myself)
Global("NinaAnomenFlirting3","GLOBAL",3)
OR(2)
Global("AnomenRomanceActive","GLOBAL",1)
Global("AnomenRomanceActive","GLOBAL",2)
See(Player1)
!StateCheck(Player1,CD_STATE_NOTVALID) 
!StateCheck(Myself,CD_STATE_NOTVALID)
CombatCounter(0)
!See([ENEMY])
Global("Nina_MeOrElse","GLOBAL",0)
THEN
RESPONSE #100
SetGlobal("Nina_MeOrElse","GLOBAL",1)
END

IF
InParty(Myself)
See(Player1)
!StateCheck(Player1,CD_STATE_NOTVALID) 
!StateCheck(Myself,CD_STATE_NOTVALID)
CombatCounter(0)
!See([ENEMY])
Global("Nina_MeOrElse","GLOBAL",1)
THEN
RESPONSE #100
Interact(Player1)
END

// Ninafer and Anomen NOT becoming a knight

