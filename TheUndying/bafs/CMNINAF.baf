	!StateCheck(Myself,CD_STATE_NOTVALID)
	See(Player1)
THEN
	RESPONSE #100
//		IncrementGlobal("NinaBackground","GLOBAL",1) // Removed set in BCMNINAF.D
		Interact(Player1)
END

