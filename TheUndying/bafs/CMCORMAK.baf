IF
	Global("CalliFoundCormak","GLOBAL",0)
	Detect("callisto")
	InParty("callisto")
	!StateCheck("callisto",CD_STATE_NOTVALID)
THEN
	RESPONSE #100
		Dialogue("callisto")
END

IF
	AttackedBy([GOODCUTOFF],DEFAULT)
THEN
	RESPONSE #100
		SetGlobal("CmCormakAttack","GLOBAL",1)
		Enemy()
END

IF
	Global("CmCormakAttack","GLOBAL",1)
	Allegiance(Myself,NEUTRAL)
THEN
	RESPONSE #100
		Enemy()
END
