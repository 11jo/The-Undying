IF
   Global("CmFarmersExists","MYAREA",0)
THEN
   RESPONSE #100
      CreateCreature("CMNIFA01",[4064.1744],3)
      CreateCreature("CMNIFA02",[4017.1758],4)
      SetGlobal("CmFarmersExists","MYAREA",1)
END

IF
   Global("CalliJoined","GLOBAL",1)
   Global("CalliFoundValis","GLOBAL",1)
   Global("CmCormakPartyExists","MYAREA",0)
THEN
   RESPONSE #100
      SetGlobal("CmCormakPartyExists","MYAREA",1)
      CreateCreature("CMCORMAK",[532.3252],3)
      CreateCreature("CMCORMA1",[460.3229],4)
      CreateCreature("CMCORMA2",[518.3309],6)
      CreateCreature("CMCORMA3",[470.3277],2)
END

IF
   Global("CalliJoined","GLOBAL",1)
   Global("CmAliskaAttack","GLOBAL",1)
   Global("CmSoranPartyExists","MYAREA",0)
THEN
