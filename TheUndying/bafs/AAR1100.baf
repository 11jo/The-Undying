      CreateCreature("CMSORA2",[2055.3247],6)
      CreateCreature("CMSORA3",[2019.3192],2)
      CreateCreature("CMSORA4",[2133.3206],2)
      CreateCreature("CMSORA5",[1969.3329],6)
      CreateCreature("CMSORA1",[1959.3320],4)
      CreateCreature("CMSORA2",[2239.3136],8)
      CreateCreature("CMSORA1",[2210.3210],4)
