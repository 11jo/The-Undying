@0  = ~Eh? <CHARNAME>, was ist das? Was geht hier vor?~ 
@1  = ~Es ist schön, Euch wiederzusehen, Nina.~
@2  = ~Ich freue mich auch, Euch wiederzusehen, mein Freund.~ ~Ich freue mich auch, Euch wiederzusehen, meine Freundin.~
@3  = ~Es ist schön, Euch wiederzuhaben! Ich benötige wieder Eure Hilfe.~
@4  = ~Ihr scheint nicht sehr überrascht, hier zu sein.~ 
@5  = ~Es ist schön, zurück zu sein! Ich werde mich bemühen, Euch zu dienen und zu helfen, wann immer ich kann. Sollen wir gehen?~
@6  = ~Klingt gut, lasst uns gehen.~
@7  = ~In Ordnung... wartet hier eine Weile, ich werde später auf Euch zurückkommen.~ 
@8  = ~Warum sollte ich überrascht sein? Wenn Ihr einen guten Schwertarm benötigt, der außerdem Zauber wirken kann, wißt Ihr, dass ich genau die richtige dafür bin.~
@9  = ~Lasst uns gehen, Nina.~ 
@10 = ~Wartet einfach hier, ich komme später auf Euch zurück.~
@11 = ~Sehr wohl. Ich werde hier warten, bis Ihr wünscht, dass ich mich der Gruppe wieder anschließe.~
@12 = ~Ja? Wünscht Ihr, dass ich mich der Gruppe anschließe?~ 
@13 = ~Ja, lasst uns gehen.~
@14 = ~Wartet hier noch eine Weile.~ 
@15 = ~Gut, gut! Ich werde hier sein, wenn Ihr mich braucht.~
