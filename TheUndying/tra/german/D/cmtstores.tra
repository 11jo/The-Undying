@0  = ~Willkommen in meinem schönen Geschäft. Darf ich Euch die heutige Spezialität anbieten?~ 
@1  = ~Spezialität? Was für eine Spezialität ist das?~
@2  = ~Nein, ich bin an der Spezialität nicht interessiert. Ich sehe mich nur um.~ 
@3  = ~Kommt jederzeit wieder.~
@4  = ~Die heutige Spezialität ist unser köstliches, langsam gebratenes Hähnchen, versehen mit unseren 20 geheimen Kräutern und Gewürzen. Dazu gibt es Kartoffelpüree und unsere spezielle Bratensauce. Möchtet Ihr davon probieren?~ 
@5  = ~Klingt gut. Ich nehme die Spezialität und würde gerne sehen, was sonst noch auf der Speisekarte steht.~
@6  = ~Nein, ich bin an der Spezialität nicht interessiert. Ich sehe mich nur um.~
@7  = ~In Ordnung, bitte sehr. Guten Appetit.~ 
@8  = ~Seid gegrüßt, Reisender. Ihr habt das Aussehen eines Abenteurers, der schon viele Meilen des Reisens und viele Begegnungen hinter sich hat. Ich habe mich gefragt, ob Ihr mir wohl bei einem Problem helfen könntet.~
@9  = ~Vielleicht sind wir in der Lage, Euch zu helfen, worin liegt das Problem?~ 
@10 = ~Entschuldigt, wir haben keine Zeit.~
@11 = ~Nun, eines Nachts hielt ich mich in einem der Gasthäuser hier in Amn auf und da stahl mir ein Dieb meinen Folianten der Magie. Dieses Buch brauche ich so schnell wie möglich wieder zurück. Ich sollte es nach Kerzenburg bringen... oje, die Hohepriesterin wird sehr verärgert sein. Könnt Ihr mir helfen?~
@12 = ~Ja. Könnt Ihr genauere Angaben über den Dieb machen, der Euch das Buch klaute?~ 
@13 = ~Nun, trotzdem danke.~
@14 = ~Ich weiß nichts über den Dieb, aber ich vermute, der Dieb arbeitete für eine Priesterin Shars. Sie folgten mir, seit ich meine Kirche vor ein paar Tagen verlassen hatte. Eine ihrer Wachen sah ich vor kurzem in dem Gasthaus "Fünf Krüge", wenn Euch das hilft.~ 
@15 = ~Wir werden unsere Suche dort beginnen und zurückkehren, wenn wir etwas Neues herausgefunden haben.~
@16 = ~Wie ich sehe, seid Ihr zurückgekehrt. Habt Ihr meinen magischen Folianten?~
@17 = ~Nein, das haben wir nicht.~
@18 = ~Bitte beeilt Euch und kehrt zurück, sobald Ihr ihn habt.~ 
@19 = ~Ihr kommt zurück und habt meinen Folianten. Ich bin Euch sehr dankbar. Dafür werde ich Euch 1000 Goldmünzen geben und Euch Zugang zu meinem Lager gewähren, solange ich hier bin.~
@20 = ~Schön, Euch zu sehen, <CHARNAME>. Was kann ich für Euch tun?~ 
@21 = ~Lasst mich sehen, was Ihr in Eurem Vorrat habt.~ 
@22 = ~Nichts.~
@23 = ~In Ordnung, dies kann ich Euch anbieten.~ 
@24 = ~Kommt zurück, wenn Ihr es Euch anders überlegt habt.~
@25 = ~Gute Geschäfte, mein Herr. Ich glaube nicht, dass ich Euch schon einmal gesehen habe... vielleicht seid Ihr daran interessiert, Euch ein paar günstige Waren anzusehen, die mir in die Hände gefallen sind?~ ~Gute Geschäfte, meine Dame. Ich glaube nicht, dass ich Euch schon einmal gesehen habe... vielleicht seid Ihr daran interessiert, Euch ein paar günstige Waren anzusehen, die mir in die Hände gefallen sind?~
@26 = ~Versucht Ihr mir gerade zu vermitteln, dass diese Waren gestohlen sind?~
@27 = ~Sicher, lasst mich sehen, was Ihr habt.~
@28 = ~Nein, ich bin daran nicht interessiert.~
@29 = ~Ich betrachte sie nicht als gestohlen, mein Herr. Lediglich als "gebraucht". Und wahrhaftig, die Leichtigkeit, mit der ich sie erlangt habe, könnte man fast mit "in die Hände gefallen" bezeichnen.~ ~Ich betrachte sie nicht als gestohlen, meine Dame. Lediglich als "gebraucht". Und wahrhaftig, die Leichtigkeit, mit der ich sie erlangt habe, könnte man fast mit "in die Hände gefallen" bezeichnen.~
@30 = ~Nun, ich werde deshalb keine Skrupel haben. Lasst mich sehen, was Ihr anzubieten habt.~
@31 = ~Kein Interesse.~
@32 = ~Eine sehr weise Entscheidung, die Ihr außerdem nicht bereuen werdet.~
@33 = ~Das ist sehr schade, mein Herr. Benötigt Ihr vielleicht ein paar Kessel? Oder soll ich ein paar Windeln für Euch auftreiben?~ ~Das ist sehr schade, meine Dame. Benötigt Ihr vielleicht ein paar Kessel? Oder soll ich ein paar Windeln für Euch auftreiben?~
@34 = ~Ah! Schön, Euch wiederzusehen, mein Herr. Seid Ihr daran interessiert, ein paar Waren durchzusehen, die mir in die Hände gefallen sind?~ ~Ah! Schön, Euch wiederzusehen, meine Dame. Seid Ihr daran interessiert, ein paar Waren durchzusehen, die mir in die Hände gefallen sind?~
@35 = ~Ihr verkauft gestohlene Waren?~
@36 = ~Ja, lasst mich sehen, was Ihr habt.~
@37 = ~Nein, danke.~
@38 = ~Willkommen in meinem Laden, kann ich Euch heute mit irgendetwas behilflich sein?~
@39 = ~Ja, ich möchte sehen, was Ihr heute zu verkaufen habt.~
@40 = ~Nein, jetzt nicht.~
@41 = ~Dies ist, was ich habe, viel Vergnügen.~
@42 = ~Willkommen zurück, möchtet Ihr sehen, was ich zu verkaufen habe?~
@43 = ~Ja, lasst mich sehen, was Ihr heute habt.~
@44 = ~Nein, jetzt nicht.~
@45 = ~Willkommen in meinem schönen Laden mit Hehlerware. Kann ich Euch heute mit irgendetwas behilflich sein?~
@46 = ~Ja, was könnt Ihr mir heute zeigen.~
@47 = ~Nichts im Moment, schätze ich.~
@48 = ~Nein, ich schätze nicht, jedenfalls jetzt nicht.~
@49 = ~Hier ist, was ich heute habe, viel Vergnügen.~
@50 = ~Seid gegrüßt, Reisender. Seid Ihr ein Anbeter Eilistraees der Dunklen Maid? Nun, es spielt keine Rolle, wir helfen jedem, egal welchem Glauben er angehört. Womit kann ich Euch dienen?~ ~Seid gegrüßt, Reisende. Seid Ihr eine Anbeterin Eilistraees der Dunklen Maid? Nun, es spielt keine Rolle, wir helfen jedem, egal welchem Glauben er angehört. Womit kann ich Euch dienen?~
@51 = ~Ich fragte mich, welche Dienste Ihr anbietet, große Priesterin Eilistraees.~
@52 = ~Zur Zeit keine, später vielleicht.~
@53 = ~Die Dunkle Maid segnet Euch, mein Kind.~

