BACKUP ~weidu_external/TheUndying/backup~

AUTHOR ~"http://www.teambg.net"~

README ~TheUndying/readme/readme-ctu.htm~

VERSION ~~

ALWAYS

ACTION_IF GAME_IS ~eet~ BEGIN
			OUTER_SET bg2_chapter = 12
		END ELSE BEGIN
			OUTER_SET bg2_chapter = 0
		END
		OUTER_FOR (i = 1 ; i <= 10 ; ++i) BEGIN
			OUTER_SET bg2_chapter = bg2_chapter + 1
			OUTER_SPRINT name_source ~bg2_chapter_%i%~
			OUTER_SET EVAL ~%name_source%~ = bg2_chapter
		END
  
    //Copies tra files into the autotra-folder (to leave the originals untouched)
    DEFINE_ACTION_FUNCTION autotra_workaround BEGIN
      COPY ~TheUndying/Languages/english~  ~weidu_external/TheUndying/Languages/autotra/%LANGUAGE%~
	  COPY ~TheUndying/Languages/english/D~  ~weidu_external/TheUndying/Languages/autotra/%LANGUAGE%/D~
      COPY ~TheUndying/Languages/%LANGUAGE%~  ~weidu_external/TheUndying/Languages/autotra/%LANGUAGE%~
	  COPY ~TheUndying/Languages/%LANGUAGE%/D~  ~weidu_external/TheUndying/Languages/autotra/%LANGUAGE%/D~
    END

    LAF autotra_workaround END

	ACTION_IF GAME_IS ~bg2ee eet~ BEGIN

  ACTION_DEFINE_ARRAY Undying_noconvert BEGIN setup_ee END

 ACTION_DEFINE_ARRAY Undying_reload BEGIN setup setup_EE END

    LAF HANDLE_CHARSETS
      INT_VAR
        infer_charsets = 1
      STR_VAR
        tra_path = EVAL ~weidu_external/TheUndying/Languages/autotra~
		out_path = EVAL ~weidu_external/TheUndying/Languages/autotra/UTF8~
		iconv_path = ~TheUndying/Languages/autotra/iconv~
        noconvert_array = Undying_noconvert
        reload_array = Undying_reload
	END
	
	// UTF8 only
	COPY ~weidu_external/TheUndying/Languages/autotra/UTF8/%LANGUAGE%~			~weidu_external/TheUndying/Languages/autotra/%LANGUAGE%~
	COPY ~weidu_external/TheUndying/Languages/autotra/UTF8/%LANGUAGE%/D~			~weidu_external/TheUndying/Languages/autotra/%LANGUAGE%/D~
	END
END

AUTO_TRA ~weidu_external/TheUndying/Languages/autotra/%s/d~

LANGUAGE ~english~
         ~english~
         ~TheUndying/Languages/english/setup.tra~

LANGUAGE ~german~
         ~german~
         ~TheUndying/Languages/german/setup.tra~
		 
LANGUAGE ~French~
         ~french~
		 ~TheUndying/Languages/english/setup.tra~
         ~TheUndying/Languages/french/setup.tra~

BEGIN @0
DESIGNATED 0
LABEL ~CoM_Solaufein-The-Undying~

PRINT @1
PRINT @2
PRINT @3
PRINT @4
PRINT @5
PRINT @6
PRINT @7
PRINT @8
PRINT @9


// REQUIRE_FILE ~Data/25Dialog.bif~ @10



APPEND ~STATE.IDS~ ~0x80101FEF CD_STATE_NOTVALID~
UNLESS ~CD_STATE_NOTVALID~

COPY ~TheUndying\bams~ ~override~

COPY ~TheUndying\areas~ ~override~

COPY ~TheUndying\sounds~ ~override~

COPY ~TheUndying\eff~ ~override~

ACTION_IF GAME_IS ~bg2ee eet~ BEGIN
  COPY ~TheUndying/portraitsEE~ ~override~
  COPY ~TheUndying/PVRZ~ ~override~   // PVRZ for EE
END ELSE BEGIN
COPY ~TheUndying/portraits~ ~override~
END

