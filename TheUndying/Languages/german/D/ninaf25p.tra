@0 = ~Ja? Oh, Ihr wünscht, dass wir uns voneinander trennen? Ich würde gerne bei Euch bleiben.~ [NINA02] 
@1 = ~Nein, bleibt vorerst in der Gruppe.~
@2 = ~Wartet hier einfach eine Weile, Nina.~ 
@3 = ~Ich werde Euch ins Einsprengsel schicken... wartet dort.~
@4 = ~Wie Ihr wünscht.~ 
@5 = ~Ja, was möchtet Ihr? Soll ich mit Euch zurückkehren?~ [NINA15]
@6 = ~Lasst uns gehen.~
@7 = ~Wartet hier noch eine Weile.~ 
@8 = ~In Ordnung, ich werde hier warten.~
