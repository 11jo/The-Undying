@0  = ~Vollidioten! Diese verdammten Vollidioten sind überall! Überall, sage ich, überall! ARGGHH!~ 
@1  = ~Ihr seid ein Vollidiot, nicht? Wenn Ihr einer seid, werde ich Euch verdammt noch mal platt machen!~
@2  = ~Überall wo ich hingehe Vollidioten! Aber nehmt Euch in Acht vor dem Meister der Vollidioten, er wird Euch kriegen, das wird er. Überall, sage ich, überall!~ 
@3  = ~Verschwindet, Kleiner, ich bin bei weitem besser als Euresgleichen... ihr seid ein Vollidiot, ja? ARGHHH!~
@4  = ~Berührt mich nicht, ich bin äußerst wichtig!~ 
@5  = ~Wollt Ihr saufen? Burrp! In Wirklichkeit bin ich der Elfengott Corellon, aber ich habe mich entschieden, Euch kleine Leute in Form eines Elfen zu besuchen. Ughhh, wo ist mein Elfenwein?~
@6  = ~Was? Ihr schon wieder? Könnt Ihr nicht sehen, dass ich voll bin?~
@7  = ~Jetzt mal in aller Ernsthaftigkeit, junge Bhaalbrut, wir werden Euren Werdegang mit großem Interesse verfolgen.~ 
@8  = ~Vel'uss? Plynn dosst iblith akh lueth z'bin!~
@9  = ~Ich verstehe Euch nicht. Sprecht Ihr die gemeine Sprache?~ 
@10 = ~Ups, tut mir leid, Euch zu belästigen.~
@11 = ~Sarn waela iblith! Lit waela lueth waela ragar brorna lueth wund nind, kyorlin elghinn. Also gut. Was wollt Ihr, <PRO_RACE>, hmmm?~
@12 = ~Was machen zwei Drow an der Oberfläche? Ist es für Euch nicht gefährlich, in der Öffentlichkeit gesehen zu werden?~ 
@13 = ~Ich wollte nur sehen, ob Ihr, neben dieser widerlichen Drow-Sprache, die gemeine Sprache sprechen könnt.~
@14 = ~Ich kann in den Oberflächenbewohner nur schwerlich eine Bedrohung sehen, sie fürchten uns wohl mehr. Aus diesem Grund hat man uns wahrscheinlich auch in Ruhe gelassen, bis Ihr herkamt und unser Mahl einfach unterbrochen habt. Und unsere Angelegenheit ist genau das, *unsere* Angelegenheit. Nun, lasst mich Euch einen Tipp geben, ich werde versuchen, ihn so einfach zu machen, dass sogar Ihr ihn verstehen könnt. Wir sind hier, um eine Person und Geschehnisse zu beobachten, die sich ereignen, während wir gerade sprechen. Mehr werde ich nicht sagen. *Vielleicht* werden wir uns wieder begegnen. Nun, um ein Zitat zu gebrauchen, das Ihr Oberflächenbewohner gerne gebraucht, "macht es wie eine Biene und zischt ab"!~ 
@15 = ~Ah, ja, genau die Antwort, die ich von Oberflächemüll erwarte. Ich würde gerne sehen, wie Ihr versucht, Drow zu sprechen, aber das ist jetzt unwichtig. Ich werde es genießen, das Blut von Euch ab- und in mich einlaufen zu lassen! Lasst uns tanzen, sollen wir?~
@16 = ~Bei der Gebieterin der Toten, geht weg!~
@17 = ~Entschuldigt bitte.~
@18 = ~Sterbt, Drow-Schlampe!~ 
@19 = ~Möge die Göttin des Todes Eure Seele verzehren!~
@20 = ~Seid gegrüßt, <SIRMAAM>. Ihr habt das Erscheinungsbild eines Abenteurers, und daher fragte ich mich, ob Ihr mir wohl helfen könntet.~ ~~ 
@21 = ~Vielleicht sind wir in der Lage, Euch zu helfen. Worin liegt das Problem?~ 
@22 = ~Tut mir leid, wir haben keine Zeit.~
@23 = ~Nun, es scheint, als hätte ich eine wertvolle Büste der Göttin Mystra verloren. Ich komme mir so verloren ohne sie vor, sie ist mein Kostbarstes. Könnt Ihr mir dabei helfen, sie zu finden?~ 
@24 = ~Gewiss können wir das. Könnt Ihr irgendwelche näheren Angaben zu ihrem Verschwinden machen?~
@25 = ~Nun gut, ich danke Euch trotzdem. Kehrt zu mir zurück, wenn Ihr Eure Meinung geändert habt.~
@26 = ~Ich lief gestern Abend durch den Tempelbezirk, als plötzlich, wie aus dem Nichts, diese Kriminellen auftauchten und mich niederschlugen. Später erwachte ich mit einer scheußlichen Beule und ohne meine Büste. Falls Ihr sie findet, werde ich eine hübsche Summe für ihre Rückkehr zahlen.~
@27 = ~Wir werden dort anfangen zu suchen und zu Euch zurückkehren, wenn wir etwas Neues herausgefunden haben.~
@28 = ~Wie ich sehe, seid Ihr zurückgekehrt. Habt Ihr meine Büste gefunden?~
@29 = ~Nein, das haben wir nicht. Wir werden unsere Suche fortsetzen.~
@30 = ~Bitte, findet sie und kehrt zurück, sobald Ihr sie habt.~
@31 = ~Ihr seid zurück und habt meine Büste der Mystra! Ich bin Euch sehr dankbar dafür. Ich werde Euch 2000 Goldstücke für ihre unversehrte Rückkehr zahlen.~
@32 = ~Ich bin erfreut, Euch wiederzusehen, <SIRMAAM>. Ich danke Euch noch einmal, dass Ihr meine Büste der Mystra für mich wiedergefunden habt.~
@33 = ~Ich war einmal wie ein weltberühmter Barde. Ja... jeder auf dem Erdball kannte mich. Möchtet Ihr gerne ein Autogramm oder so etwas? Bitte?~
@34 = ~Hattet Ihr jemals dieses plötzliche intensive Verlangen nach etwas? Ich habe eines nach etwas Süßem. Vielleicht eine Banane?~
@35 = ~Der jetzige Dialog-Zustand wird nie enden, weil das Geplänkel nicht fertig geladen ist.~
@36 = ~Ich bin total berühmt. Ihr habt wahrscheinlich schon von mir gehört. Es gibt überall in der Stadt riesige Plakate von mir. Ich bin wie Euer Vorbild, nicht wahr?~
@37 = ~Ich bin nur Wache, belästigt jemand anderen, Kleiner.~ ~Ich bin nur Wache, belästigt jemand anderen, Kleine.~
@38 = ~Ich werde Euch zerquetschen, zu Schleim zerquetschen!~
@39 = ~Ihr wünscht ein kurzes Leben?~
@40 = ~Seid gegrüßt, Söldner! Mein Name ist Raven und ich fragte mich, ob Ihr etwas für mich tun könntet. Ich verspreche eine angemessene Belohnung, wenn Ihr annehmt.~
@41 = ~Was sollen wir für Euch tun, schöne Dame?~
@42 = ~Nicht jetzt, ein ander Mal vielleicht.~
@43 = ~Mir ist etwas sehr Schreckliches zugestoßen. Ich besaß ein sehr schönes altes Buch, das meiner Familie schon seit Generationen gehört, es wurde aus meinem Zimmer gestohlen. Ich will mein Buch zurück und ich werde Euch für dessen Rückkehr angemessen entlohnen. Werdet Ihr mir helfen?~
@44 = ~Das ist in der Tat eine scheußliche Sache, meine schöne Dame, welch schmutziger Dieb würde so etwas tun?~
@45 = ~Na schön, ich werde hier warten, für den Fall, Ihr ändert Eure Meinung.~
@46 = ~Ich konnte es in der Dunkelheit nicht genau erkennen, aber ich denke, es war entweder eine Gruppe Zwerge oder eine Gruppe Halblinge, wenn man von der Größe ausgeht. Alle drei waren klein und rochen nach Kanalisation. Außerdem hatten sie einen seltsamen Akzent, weshalb ich eben denke, dass es Zwerge oder Halblinge waren. Sie sprachen davon, eine andere Gruppe irgendwo im Tempelbezirk zu überfallen. Das ist alles, was ich weiß.~
@47 = ~Sehr gut, wir werden diese Diebe zur Strecke und Euch Euer Buch bringen.~
@48 = ~Ihr kehrt zurück, und ohne mein Buch, wie ich sehe. Ich habe Euch nichts weiter zu sagen, bis Ihr mein Buch wiedererlangt habt. Nun geht!~
@49 = ~Wie ich sehe, habt Ihr mein Buch. Vielen Dank, dass Ihr es mir zurückgebracht habt.~
@50 = ~Ich habe Euch eine Belohnung für die Wiederbeschaffung des Buches versprochen. Hier, nehmt dies, ich habe nur wenig Verwendung für Gold.~
@51 = ~Ich danke Euch dafür, dass Ihr mir mein Buch zurückgebracht habt, aber ich möchte nicht gestört werden, während ich die Geheimnisse dieses Buches erforsche. Bitte überlasst mich nun meiner Lektüre.~
@52   = ~Hey, klickt mich nicht an, ich will keine Probleme haben! Äh, ich weiß, Ihr seid der Bastard, der Marl getötet hat.~ [DUNKN02]
@53   = ~Dunkin, was macht Ihr hier?~
@54   = ~Das geht Euch nichts an, Killer. Lasst mich einfach meinen Trunk genießen oder ich werde die Wache rufen.~
@55   = ~Ich ignoriere Euch. Geht weg.~
@56 = ~Ja? Gibt es etwas, das ich für Euch tun kann? Ich will nicht unhöflich erscheinen, aber Ihr und Eure Freunde seht nicht aus wie die Art Kundschaft, die die Preise in meiner schönen Taverne bezahlen können. Nur die reichen und höher stehenden Bürger können es sich leisten, hier zu verkehren.~
@57 = ~Für einen Zwerg scheint Ihr sehr gebildet und unhöflich noch dazu.~
@58 = ~Ich würde nicht mal ein halbes Kupferstück hergeben, um in diesem Saftladen bleiben zu dürfen.~
@59 = ~Saftladen sagt Ihr? Dann lasst mich Euch mitteilen, dass König Azoun IV. und sein Gefolge hier verweilt haben. Sobald Ihr Euch ein paar Manieren angeeignet habt, dürft Ihr zurückkehren.~
@60 = ~Wie Ihr wünscht. Entschuldigt die Beleidigung.~
@61 = ~Warum bringen wir statt dessen nicht Euch ein paar Manieren bei?~
@62 = ~Ah, ja, ja, verschwindet!~
@63 = ~Ah, ja, ganz die typische Antwort von jemandem, der in niederem Stand geboren wurde. Ich werde Euer schlechtes Betragen nicht länger dulden. Wachen, entfernt diesen Schmutz aus meinen Augen!~
@64 = ~Natürlich bin ich gebildet, und warum sollte ich das auch nicht sein? Ihr nahmt an, weil ich ein Zwerg bin, dass ich ein ungebildeter Neanderthaler sei, der fässerweise irgendein Gesöff in sich hineinschüttet, als würde es unmodern werden, und der alles kurz und klein schlägt, das ihm in den Weg kommt, richtig?~
@65 = ~Aber...~
@66 = ~Ich stamme aus einer sehr bekannten Familie und wurde von den besten Lehrern erzogen, die Gold kaufen kann. Ich leite ein sehr erfolgreiches Unternehmen und plane, es weiter auszubauen, vielleicht sogar in eine Richtung, die nichts mit Tavernenverwaltung zu tun hat.~
@67 = ~Dann haben wir Euch, den typischen "Abenteurer". Ihr seid ärmlich gekleidet, habt seit Monaten nicht gebadet, Eurem üblen Geruch nach zu urteilen, und werdet jede banale Aufgabe annehmen, wie zum Beispiel: "Holt ein wenig Schmuck und Ihr erhaltet eine kleine Belohnung, wie ein liebes Hündchen". Oder: "Tötet einen Stall voller Ratten und Ihr erhaltet fünf Goldstücke für Eure Bemühungen". Steht dort nicht mit offenen Mündern, sonst lasst Ihr die Fliegen hinein.~
@68 = ~(Ihr seid sprachlos.)~
@69 = ~Der "mächtige" und edle Abenteurer ist zurückgekehrt. Welchem Anliegen habe ich diese "Ehre" zu verdanken?~
@70 = ~Wir brauchen ein Zimmer und Ihr solltet Euch besser beeilen, es uns zu zeigen.~
@71 = ~Ich habe genug von Eurer arroganten Art. Es wird Zeit, Euch ein paar Manieren beizubringen!~
@72 = ~Äh... im Moment keinem. Vielleicht ein ander Mal.~
@73 = ~Achtet auf Eure Zunge, bevor ich Bruno hier befehle, sie Euch zu nehmen. Nun, hier ist mein Angebot.~
@74 = ~Warum ich, Moradin, warum ich? Jungs, es ist Zeit, den Müll rauszubringen.~
